{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cargo build (clipflow-app)",
            "type": "cargo",
            "command": "build",
            "args": [
                "-p",
                "clipflow-app"
            ],
            "problemMatcher": [
                "$rustc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "cargo build (release)",
            "type": "cargo",
            "command": "build",
            "args": [
                "--release",
                "-p",
                "clipflow-app"
            ],
            "problemMatcher": [
                "$rustc"
            ],
            "group": "build"
        },
        {
            "label": "cargo run (clipflow-app)",
            "type": "cargo",
            "command": "run",
            "args": [
                "-p",
                "clipflow-app"
            ],
            "problemMatcher": [
                "$rustc"
            ]
        },
        {
            "label": "cargo test (workspace)",
            "type": "cargo",
            "command": "test",
            "args": [
                "--workspace"
            ],
            "problemMatcher": [
                "$rustc"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "cargo test (m1_av_sync_bench)",
            "type": "cargo",
            "command": "test",
            "args": [
                "--test",
                "m1_av_sync_bench",
                "--",
                "--nocapture"
            ],
            "problemMatcher": [
                "$rustc"
            ],
            "group": "test"
        },
        {
            "label": "cargo clippy (workspace)",
            "type": "cargo",
            "command": "clippy",
            "args": [
                "--workspace",
                "--",
                "-D",
                "warnings"
            ],
            "problemMatcher": [
                "$rustc"
            ]
        },
        {
            "label": "uv pytest (python worker)",
            "type": "shell",
            "command": "uv run pytest",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}

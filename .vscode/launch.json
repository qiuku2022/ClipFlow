{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run ClipFlow (CodeLLDB)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/target/debug/clipflow-app.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "cargo build",
            "sourceLanguages": ["rust"],
            "env": {
                "RUST_LOG": "info",
                "RUST_BACKTRACE": "1"
            }
        },
        {
            "name": "Run ClipFlow (MSVC)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/target/debug/clipflow-app.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "cargo build",
            "env": {
                "RUST_LOG": "info",
                "RUST_BACKTRACE": "1"
            }
        },
        {
            "name": "Run Python Tests",
            "type": "python",
            "request": "launch",
            "module": "pytest",
            "args": [
                "python/tests"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/python"
            }
        }
    ]
}
